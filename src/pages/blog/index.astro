---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-US", {
    month: "short", day: "numeric", year: "numeric", timeZone: "UTC",
  });
---
<Base title="Blog">
  <h1 class="text-3xl font-bold mb-2">Blog</h1>
  <p class="mb-10 text-muted">
    Notes on computer vision, machine learning, robotics, and the systems behind them.
  </p>

  {posts.length === 0 && <p>No posts yet.</p>}

  <ul>
    {posts.map((p) => (
      <li class="py-1.5 flex items-baseline gap-5 sm:gap-7">
        <time
          datetime={p.data.date.toISOString().slice(0, 10)}
          class="shrink-0 w-28 tabular-nums text-base text-muted">
          {fmt(p.data.date)}
        </time>
        <a href={`/blog/${p.id}/`} class="min-w-0 text-base leading-snug transition-opacity hover:opacity-80">
          {p.data.title}
        </a>
      </li>
    ))}
  </ul>
</Base>
